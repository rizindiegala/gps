# Copia questo file in .env e inserisci le credenziali Genba.
# Il file .env non viene committato.

GENBA_USERNAME=
GENBA_PASSWORD=

# Chiave dell'API dei tassi di cambio (currencylayer / apilayer.net)
CURRENCYLAYER_API_KEY=

# Opzionali: normalmente non servono, perche' Selenium si procura da se' il
# chromedriver e, se manca, anche Chrome. Da usare solo se la rete blocca i
# download di Google, indicando un driver e un Chrome gia' presenti nel sistema.
# CHROMEDRIVER_PATH=
# CHROME_BINARY=
